diff --git a/src/CrnnNet.cpp b/src/CrnnNet.cpp
index 2800e59..330b9c8 100644
--- a/src/CrnnNet.cpp
+++ b/src/CrnnNet.cpp
@@ -4,7 +4,7 @@
