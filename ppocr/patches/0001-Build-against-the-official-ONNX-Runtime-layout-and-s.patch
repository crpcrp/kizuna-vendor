From 51ec558b32a6f39985d0b87944994624931e6a39 Mon Sep 17 00:00:00 2001
From: Adam Kocsis <kocsisadam1991@gmail.com>
Date: Wed, 12 Aug 2026 09:22:28 +0200
Subject: [PATCH 1/3] Build against the official ONNX Runtime layout and stop
 crashing on init failure

- Include <onnxruntime_cxx_api.h> / <dml_provider_factory.h> as the official
  Microsoft NuGet lays them out, instead of RapidAI's nested tree.
- Initialise every Ort::Session* to nullptr. Upstream leaves them wild, so any
  failure before initModel turns a reportable error into an access violation in
  the destructor, which makes a clean fallback impossible.
- Strip a trailing CR when reading keys.txt, so a CRLF copy cannot silently
  corrupt every decoded character.
- Widen model paths with MultiByteToWideChar(CP_UTF8) instead of byte-by-byte,
  which mangled any non-ASCII path.
---
 include/AngleNet.h    |  4 ++--
 include/CrnnNet.h     |  4 ++--
 include/DbNet.h       |  8 ++++++--
 include/OcrLiteImpl.h |  2 +-
 include/OcrUtils.h    |  2 +-
 src/AngleNet.cpp      |  2 +-
 src/CrnnNet.cpp       |  5 ++++-
 src/OcrUtils.cpp      | 13 +++++++++++++
 8 files changed, 30 insertions(+), 10 deletions(-)

diff --git a/include/AngleNet.h b/include/AngleNet.h
index d14503c..25de290 100644
--- a/include/AngleNet.h
+++ b/include/AngleNet.h
@@ -2,7 +2,7 @@
 #define __OCR_ANGLENET_H__
 
 #include "OcrStruct.h"
-#include <onnxruntime/core/session/onnxruntime_cxx_api.h>
+#include <onnxruntime_cxx_api.h>
 #include <opencv2/opencv.hpp>
 
 class AngleNet {
@@ -22,7 +22,7 @@ public:
 private:
     bool isOutputAngleImg = false;
 
-    Ort::Session *session;
+    Ort::Session *session = nullptr;
     Ort::Env env = Ort::Env(ORT_LOGGING_LEVEL_ERROR, "AngleNet");
     Ort::SessionOptions sessionOptions = Ort::SessionOptions();
     int numThread = 0;
