*.exe filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.dic filter=lfs diff=lfs merge=lfs -text

paddleocr/models/**/inference.pdiparams filter=lfs diff=lfs merge=lfs -text
# Small enough for a plain blob, but it must survive byte for byte: the warm
# latency and the recognized text are both measured against these exact pixels.
scripts/testdata/*.png binary
paddleocr/models/**/inference.json -text
paddleocr/models/**/inference.yml -text
paddleocr/licenses/* -text
paddleocr/worker/*.cc text eol=lf
paddleocr/worker/*.patch text eol=lf

# Spike artifacts (#11). keys.txt must stay LF: RapidOcrOnnx reads it with
# getline and would keep a CR on every entry.
spike/**/*.patch text eol=lf
spike/**/keys.txt text eol=lf
spike/**/*.py text eol=lf
spike/**/*.cpp text eol=lf
spike/**/*.txt text eol=lf

linux-x64/mpv/bin/mpv filter=lfs diff=lfs merge=lfs -text
linux-x64/ffmpeg/bin/ffmpeg filter=lfs diff=lfs merge=lfs -text
linux-x64/ffmpeg/bin/ffprobe filter=lfs diff=lfs merge=lfs -text
linux-x64/mecab/lib/*.so* filter=lfs diff=lfs merge=lfs -text

scripts/*.sh text eol=lf
scripts/*.ps1 text eol=crlf
linux-x64/mecab/bin/mecab text eol=lf
linux-x64/mecab/etc/mecabrc text eol=lf

mecab/ipadic/Adj.csv filter=lfs diff=lfs merge=lfs -text
mecab/ipadic/matrix.def filter=lfs diff=lfs merge=lfs -text
mecab/ipadic/Noun.csv filter=lfs diff=lfs merge=lfs -text
mecab/ipadic/Noun.name.csv filter=lfs diff=lfs merge=lfs -text
mecab/ipadic/Noun.org.csv filter=lfs diff=lfs merge=lfs -text
mecab/ipadic/Noun.place.csv filter=lfs diff=lfs merge=lfs -text
mecab/ipadic/Noun.proper.csv filter=lfs diff=lfs merge=lfs -text
mecab/ipadic/Verb.csv filter=lfs diff=lfs merge=lfs -text
