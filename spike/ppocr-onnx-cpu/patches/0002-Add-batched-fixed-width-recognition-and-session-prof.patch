+std::vector<TextLine> CrnnNet::getTextLinesBatched(std::vector<cv::Mat> &partImg, int batchSize, int fixedWidth) {
+    const size_t count = partImg.size();
+    std::vector<TextLine> textLines(count);
+    if (count == 0) return textLines;
+    if (batchSize < 1) batchSize = 1;
+
+    const size_t planeSize = (size_t) dstHeight * (size_t) fixedWidth;
+    auto memoryInfo = Ort::MemoryInfo::CreateCpu(OrtDeviceAllocator, OrtMemTypeCPU);
+    std::vector<const char *> inputNames = {inputNamesPtr.data()->get()};
+    std::vector<const char *> outputNames = {outputNamesPtr.data()->get()};
+
+    for (size_t begin = 0; begin < count; begin += (size_t) batchSize) {
+        const size_t end = (std::min)(begin + (size_t) batchSize, count);
+        const size_t n = end - begin;
+
+        // Zero after normalization is mid-grey, which is what PaddleOCR pads
+        // the recognizer input with.
+        std::vector<float> input(n * 3 * planeSize, 0.0f);
+
+        for (size_t b = 0; b < n; ++b) {
+            cv::Mat &src = partImg[begin + b];
+            float scale = (float) dstHeight / (float) src.rows;
+            int w = (std::max)(1, (std::min)(fixedWidth, (int) ((float) src.cols * scale)));
+            cv::Mat resized;
+            cv::resize(src, resized, cv::Size(w, dstHeight));
+            const size_t channels = resized.channels();
+            float *dst = input.data() + b * 3 * planeSize;
+            for (int y = 0; y < dstHeight; ++y) {
+                const unsigned char *row = resized.ptr<unsigned char>(y);
+                for (int x = 0; x < w; ++x) {
+                    for (size_t ch = 0; ch < channels; ++ch) {
+                        dst[ch * planeSize + (size_t) y * fixedWidth + x] =
+                                (float) row[x * channels + ch] * normValues[ch] -
+                                meanValues[ch] * normValues[ch];
+                    }
+                }
+            }
+        }
+
+        std::array<int64_t, 4> inputShape{(int64_t) n, 3, dstHeight, fixedWidth};
+        Ort::Value inputTensor = Ort::Value::CreateTensor<float>(memoryInfo, input.data(), input.size(),
+                                                                inputShape.data(), inputShape.size());
+        auto outputTensor = session->Run(Ort::RunOptions{nullptr}, inputNames.data(), &inputTensor,
+                                         inputNames.size(), outputNames.data(), outputNames.size());
+        std::vector<int64_t> outputShape = outputTensor[0].GetTensorTypeAndShapeInfo().GetShape();
+        const size_t steps = (size_t) outputShape[1];
+        const size_t classes = (size_t) outputShape[2];
+        float *floatArray = outputTensor.front().GetTensorMutableData<float>();
+
+        for (size_t b = 0; b < n; ++b) {
+            std::vector<float> one(floatArray + b * steps * classes,
+                                  floatArray + (b + 1) * steps * classes);
+            textLines[begin + b] = scoreToTextLine(one, steps, classes);
+        }
+    }
+    return textLines;
+}
