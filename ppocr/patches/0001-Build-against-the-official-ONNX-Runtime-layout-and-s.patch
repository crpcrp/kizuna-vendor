diff --git a/include/DbNet.h b/include/DbNet.h
index e2b9a17..ccbe286 100644
--- a/include/DbNet.h
+++ b/include/DbNet.h
@@ -2,7 +2,7 @@
 #define __OCR_DBNET_H__
 
 #include "OcrStruct.h"
-#include <onnxruntime/core/session/onnxruntime_cxx_api.h>
+#include <onnxruntime_cxx_api.h>
 #include <opencv2/opencv.hpp>
 
 class DbNet {
@@ -19,7 +19,11 @@ public:
                                       float boxThresh, float unClipRatio);
 
 private:
-    Ort::Session *session;
+    // Never initialised upstream: if anything fails before initModel (a
+    // missing model file, an unusable execution provider) the destructor
+    // deletes a wild pointer and the process dies with an access violation
+    // instead of reporting the error and falling back.
+    Ort::Session *session = nullptr;
     Ort::Env env = Ort::Env(ORT_LOGGING_LEVEL_ERROR, "DbNet");
     Ort::SessionOptions sessionOptions = Ort::SessionOptions();
     int numThread = 0;
