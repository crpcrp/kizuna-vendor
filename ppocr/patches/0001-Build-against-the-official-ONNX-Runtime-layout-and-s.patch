-#include <onnxruntime/core/providers/dml/dml_provider_factory.h>
+#include <dml_provider_factory.h>
 #endif
 
 void CrnnNet::setGpuIndex(int gpuIndex) {
@@ -79,6 +79,9 @@ void CrnnNet::initModel(const std::string &pathStr, const std::string &keysPath)
     std::string line;
     if (in) {
         while (getline(in, line)) {// line中不包括每行的换行符
+            // keys.txt is written with LF, but a CRLF copy would otherwise
+            // append a stray \r to every entry and corrupt the decoded text.
+            if (!line.empty() && line.back() == '\r') line.pop_back();
             keys.push_back(line);
         }
     } else {
diff --git a/src/OcrUtils.cpp b/src/OcrUtils.cpp
index 7c3ea3f..c9b0ca4 100755
--- a/src/OcrUtils.cpp
+++ b/src/OcrUtils.cpp
@@ -1,3 +1,6 @@
+#ifdef _WIN32
+#include <windows.h>
+#endif
 #include <opencv2/imgproc.hpp>
 #include <opencv2/imgcodecs.hpp>
 #include <numeric>
@@ -12,9 +15,19 @@ double getCurrentTime() {
 std::wstring strToWstr(std::string str) {
     if (str.length() == 0)
         return L"";
+#ifdef _WIN32
+    // The original widened byte-by-byte, which mangles any non-ASCII model
+    // path. Kizuna installs under the user profile, which routinely contains
+    // them.
+    int needed = MultiByteToWideChar(CP_UTF8, 0, str.c_str(), (int) str.size(), nullptr, 0);
+    std::wstring wstr(needed, L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, str.c_str(), (int) str.size(), &wstr[0], needed);
+    return wstr;
+#else
     std::wstring wstr;
     wstr.assign(str.begin(), str.end());
     return wstr;
+#endif
 }
 
 ScaleParam getScaleParam(cv::Mat &src, const float scale) {
